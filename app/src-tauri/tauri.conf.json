{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tingzi",
  "version": "0.7.0",
  "identifier": "app.tingzi.voice",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "capsule",
        "title": "聽字",
        "width": 460,
        "height": 92,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "shadow": true
      }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self'; script-src 'self'" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
